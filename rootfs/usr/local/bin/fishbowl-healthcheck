#!/usr/bin/env bash
# Docker HEALTHCHECK: healthy only when MySQL answers and Fishbowl Server accepts
# connections on its client port. The reason is printed for `docker inspect`.
set -u
status="$(cat /run/fishbowl/status 2>/dev/null || echo unknown)"
if [ "$status" != running ]; then
  case "$status" in
    needs-setup)         echo "First-time setup is waiting for you on the Fishbowl page (docker exec <container> fishbowl-link)" ;;
    setup)               echo "First-time setup in progress" ;;
    awaiting-database)   echo "No company database selected yet: restore or create one on the Fishbowl page" ;;
    starting)            echo "Fishbowl Server is starting (after an upgrade it updates the database first)" ;;
    stopping-server)     echo "Fishbowl Server is stopping (asked for on the Fishbowl page)" ;;
    paused)              echo "Fishbowl Server is stopped (stopped on the Fishbowl page, or the admin command); start it on the page" ;;
    server-failed)       echo "Fishbowl Server could not start; the Fishbowl page and the container log say why" ;;
    upgrading)           echo "Upgrade in progress" ;;
    upgrade-interrupted) echo "An upgrade did not finish; run it again on the Fishbowl page" ;;
    no-volumes)          echo "Started without the three volumes; nothing is running (see the container log)" ;;
    foreign-data)        echo "The volumes hold data this container did not set up; nothing is running (see the container log)" ;;
    downgrade)           echo "This image is older than the installed Fishbowl; nothing is running (see the container log)" ;;
    *)                   echo "Not running yet (status: $status)" ;;
  esac
  exit 1
fi
if ! mysqladmin --protocol=socket --socket=/var/lib/mysql/mysql.sock ping --silent >/dev/null 2>&1; then
  echo "MySQL is not answering"
  exit 1
fi
port="$(python3 -I /usr/local/lib/fishbowl/props.py get /opt/Fishbowl/server/bin/eve.properties webPort 2>/dev/null || echo 2456)"
if ! timeout 5 bash -c "exec 3<>/dev/tcp/127.0.0.1/$port" 2>/dev/null; then
  echo "Fishbowl Server is not accepting connections on port $port"
  exit 1
fi
echo "MySQL and Fishbowl Server are up (client port $port)"
