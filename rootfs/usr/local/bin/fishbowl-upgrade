#!/usr/bin/env bash
# fishbowl-upgrade: upgrade Fishbowl at a terminal instead of on the Fishbowl page.
#
#   docker exec -it fishbowl fishbowl-upgrade
#
# For when the image carries a newer Fishbowl than the one installed. Shows the
# new version's license agreement, asks for the MySQL root password (the
# databases are backed up first), then the container upgrades on its own.

# shellcheck source=/dev/null
. /usr/local/lib/fishbowl/common.sh
# shellcheck source=/dev/null
. "$LIB_DIR/setup.sh"
# shellcheck source=/dev/null
. "$LIB_DIR/upgrade.sh"

[ "$(id -u)" = 0 ] || fail 1 "Run it as root: docker exec -it <container> fishbowl-upgrade"
setup_complete || fail 1 "Fishbowl isn't installed yet; first-time setup comes first (the Fishbowl page, or fishbowl-setup)."
from="$(installed_version)"
info() { sed -n "s/^$1=//p" "$INFO_FILE" 2>/dev/null | head -n 1; }
if [ "$(info upgrade_blocked)" = trial ]; then
  note ""; trial_upgrade_text "$from"; note ""
  exit 7
fi
[ -n "$(info upgrade_to)" ] ||
  fail 1 "Nothing to upgrade: Fishbowl $from is installed and this image carries $FISHBOWL_VERSION."
case "$(current_status)" in
  upgrading) fail 1 "An upgrade is already running. Follow it with: docker logs -f <container>" ;;
esac
is_interactive || fail 1 "fishbowl-upgrade asks questions, so it needs a terminal: docker exec -it <container> fishbowl-upgrade (or use the Fishbowl page)."
mysql_is_up || fail 1 "MySQL isn't running in this container right now; try again in a moment."
trap 'upgrade_cleanup; setup_cleanup' EXIT

hr
note " Fishbowl upgrade: $from  ->  $FISHBOWL_VERSION"
hr
note "This image carries Fishbowl $FISHBOWL_APP_VERSION (installer $FISHBOWL_VERSION). Your volumes have $from."
note "To upgrade: accept the license agreement for $FISHBOWL_VERSION, then enter the MySQL root"
note "password so the databases can be backed up first. After that it runs on its own:"
note "Fishbowl Server stops (Fishbowl Clients are disconnected), backup, then Fishbowl's"
note "installer updates /opt/Fishbowl in place. Your company name, license key and data"
note "are kept, and MySQL is not re-initialized."
note ""

rc=0
eula_accept || rc=$?
if [ "$rc" = 2 ]; then
  note ""; note "No answer came from the terminal; nothing was changed."
  exit 3
elif [ "$rc" != 0 ]; then
  note ""
  note "You did not accept the license agreement for $FISHBOWL_VERSION, so nothing was upgraded or"
  note "changed. Fishbowl $from and its data are untouched and keep running."
  exit 1
fi
note "License agreement for $FISHBOWL_VERSION accepted."
note ""
hr
note "MySQL root password (the one chosen at first setup), for the pre-upgrade backup."
rc=0
ask_root_password_until_valid || rc=$?
if [ "$rc" != 0 ]; then
  note "Without the MySQL root password the backup can't run, so nothing was upgraded."
  exit "$([ "$rc" = 2 ] && echo 3 || echo 1)"
fi

SETUP_SECRETS="$(secret_dir)"
write_answers "$SETUP_SECRETS/answers" upgrade
rm -f "$LAST_ERROR_FILE"
web_request upgrade "$SETUP_SECRETS/answers"
setup_cleanup
upgrade_cleanup

note ""
note "Upgrading now. No more questions. The container log shows each step"
note "(docker logs -f <container>), and so does the Fishbowl page."
seen=0
for _ in $(seq 1 3600); do
  sleep 2
  status="$(current_status)"
  if [ "$(installed_version)" = "$FISHBOWL_VERSION" ] && [ ! -f "$STATE_DIR/upgrade.in-progress" ]; then
    note ""
    note "Upgrade to Fishbowl $FISHBOWL_APP_VERSION finished. Fishbowl Server is starting; after an"
    note "upgrade it updates the database first, which can take a while on a large one."
    exit 0
  fi
  if [ "$status" = upgrading ]; then seen=1; continue; fi
  if [ -s "$LAST_ERROR_FILE" ]; then
    note ""
    note "The upgrade did not finish:"
    note "  $(cat "$LAST_ERROR_FILE")"
    exit 1
  fi
  if [ "$seen" = 1 ]; then
    note ""
    note "The upgrade did not finish; the container log has the reason (docker logs <container>)."
    exit 1
  fi
done
fail 1 "The upgrade is taking unusually long; check docker logs <container>."
