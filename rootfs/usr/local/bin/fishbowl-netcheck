#!/usr/bin/env bash
#
# fishbowl-netcheck: can this container reach Fishbowl's servers, and what does
# Fishbowl Server listen on? For firewall questions: licenses, plugins and the
# Integrations group of the Fishbowl Client need Fishbowl's servers. Changes
# nothing; it only opens (and closes) a connection to each address.
#
#   docker exec fishbowl fishbowl-netcheck    a full report
#   fishbowl-netcheck --log                   used at container start: one warning line
#                                             for the container log, only when something
#                                             Fishbowl uses can't be reached
#
# Exit status: 0 when every server Fishbowl uses answered, 1 when one didn't.
#
# There is no firewall inside the container: everything may go out, and Docker
# lets in only the ports you publish (-p). So a server that can't be reached is
# blocked outside the container (this computer's firewall, the router, the
# network), and this report says which.

# shellcheck source=/usr/local/lib/fishbowl/common.sh
. /usr/local/lib/fishbowl/common.sh
set +o errexit

MODE=report
case "${1:-}" in
  --log) MODE=log ;;
  ""|--report) ;;
  -h|--help) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) fail 2 "Usage: fishbowl-netcheck [--log]" ;;
esac

# What Fishbowl 26.10 contacts, by the names in its own program files. Fishbowl
# uses the names, so the addresses behind them can change; firewall rules by
# name keep working when they do.
NAMED=(
  "fishbowlconnect.com|81|plugins: the Plugins module's list and plugin updates"
  "fishbowlconnect.com|443|plugin downloads, payments, what's new"
  "artanis.fishbowldev.com|443|license, subscription, feature and plugin checks"
  "files.fishbowlinventory.com|80|the security patch list"
  "files.fishbowlinventory.com|443|file downloads"
  "www.fishbowlinventory.com|443|Fishbowl's web pages (help and sales links)"
)
# The addresses on Fishbowl's network cutsheet (v3). Reported, but not counted
# in the result: Fishbowl 26.10 doesn't name them anywhere.
CUTSHEET=(
  "97.75.181.50|80|File Manager Server" "97.75.181.50|81|File Manager Server" "97.75.181.50|443|File Manager Server"
  "97.75.181.39|80|License/Plugin Server" "97.75.181.39|81|License/Plugin Server" "97.75.181.39|443|License/Plugin Server"
  "199.79.55.108|80|Support Server" "199.79.55.108|81|Support Server" "199.79.55.108|443|Support Server"
)

TMP="$(mktemp -d /dev/shm/netcheck.XXXXXX)" || fail 1 "No room for a temporary folder."
trap 'rm -rf "$TMP"' EXIT

# probe HOST PORT -> "<status> <address>"; status: reachable | refused | no-answer | no-name
probe() {
  local host="$1" port="$2" addr rc
  if [[ "$host" =~ ^[0-9.]+$ ]]; then
    addr="$host"
  else
    addr="$(timeout 5 getent ahostsv4 "$host" 2>/dev/null | awk 'NR==1 {print $1}')"
    [ -n "$addr" ] || { echo "no-name -"; return; }
  fi
  timeout 5 bash -c 'exec 3<>"/dev/tcp/$1/$2"' _ "$addr" "$port" 2>/dev/null
  rc=$?
  case "$rc" in
    0)   echo "reachable $addr" ;;
    124) echo "no-answer $addr" ;;
    *)   echo "refused $addr" ;;
  esac
}

# All at once, so the whole check takes about five seconds.
i=0
for entry in "${NAMED[@]}" "${CUTSHEET[@]}"; do
  IFS='|' read -r host port _ <<<"$entry"
  probe "$host" "$port" > "$TMP/$i" &
  i=$((i + 1))
done
wait

words() {
  case "$1" in
    reachable) echo "reachable" ;;
    refused)   echo "REFUSED" ;;
    no-answer) echo "NO ANSWER" ;;
    no-name)   echo "NO DNS NAME" ;;
    *)         echo "?" ;;
  esac
}

i=0; BAD=(); NAMED_LINES=(); CUT_LINES=()
for entry in "${NAMED[@]}"; do
  IFS='|' read -r host port what <<<"$entry"
  read -r status addr < "$TMP/$i"; i=$((i + 1))
  NAMED_LINES+=("$(printf '  %-12s %-34s %-16s %s' "$(words "$status")" "$host:$port" "$addr" "$what")")
  [ "$status" = reachable ] || BAD+=("$host:$port ($(words "$status" | tr 'A-Z' 'a-z'))")
done
for entry in "${CUTSHEET[@]}"; do
  IFS='|' read -r host port what <<<"$entry"
  read -r status addr < "$TMP/$i"; i=$((i + 1))
  CUT_LINES+=("$(printf '  %-12s %-34s %s' "$(words "$status")" "$host:$port" "$what")")
done

if [ "$MODE" = log ]; then
  if [ "${#BAD[@]}" -gt 0 ]; then
    warn "Fishbowl's servers can't be reached from this container: ${BAD[*]}. Licenses, plugins and the Integrations group need them; something outside the container blocks them (this computer's firewall, the router or the network). Details: docker exec fishbowl fishbowl-netcheck"
    exit 1
  fi
  exit 0
fi

# The ports something listens on for the network (not just inside the container).
listening() {
  local f
  for f in /proc/net/tcp /proc/net/tcp6; do
    [ -r "$f" ] || continue
    awk 'NR > 1 && $4 == "0A" { split($2, a, ":"); if (a[1] ~ /^0+$/) print strtonum("0x" a[2]) }' "$f"
  done | sort -nu
}
port_name() {
  case "$1" in
    2456)  echo "Fishbowl Clients (Fishbowl Server's webPort)" ;;
    28192) echo "Fishbowl's API: integrated apps and integrations (Fishbowl Server's port)" ;;
    6080)  echo "the Fishbowl page (publish it on 127.0.0.1 only)" ;;
    28182) echo "Fishbowl's web client, HTTP (Webswing; this image doesn't start it)" ;;
    28282) echo "Fishbowl's web client, HTTPS (Webswing; this image doesn't start it)" ;;
    *)     echo "(not one of Fishbowl's)" ;;
  esac
}

note "Fishbowl's servers, by the names Fishbowl $FISHBOWL_APP_VERSION uses (outbound from this container):"
printf '%s\n' "${NAMED_LINES[@]}"
note ""
note "The addresses on the network cutsheet (outbound; Fishbowl doesn't name these itself):"
printf '%s\n' "${CUT_LINES[@]}"
note ""
note "Listening for the network in this container (inbound; Docker lets in only the ports you publish):"
LISTEN="$(listening)"
for p in $LISTEN; do
  printf '  %-6s %s\n' "$p" "$(port_name "$p")"
done
unused=()
for p in 80 81 443 3305 3306 8080 28182 28282 28292; do
  grep -qx "$p" <<<"$LISTEN" || unused+=("$p")
done
[ "${#unused[@]}" -eq 0 ] || note "  Cutsheet ports nothing listens on here: ${unused[*]}"
grep -qx 3306 <<<"$LISTEN" || note "  (MySQL's 3306 listens on the container's own loopback only, on purpose.)"
note ""
if [ "${#BAD[@]}" -eq 0 ]; then
  note "Result: every server Fishbowl uses answered."
  exit 0
fi
note "Result: not reachable from this container: ${BAD[*]}."
note "There's no firewall inside the container, so something outside it blocks these: the"
note "firewall on this computer, the router or the network. Licenses, plugins and the"
note "Integrations group of the Fishbowl Client need them."
note "  REFUSED     something answered with a refusal (a firewall's reject rule, or a proxy)"
note "  NO ANSWER   the connection was silently dropped (a firewall's drop rule, or no route)"
note "  NO DNS NAME the name didn't resolve (DNS isn't reaching the internet)"
exit 1
