#!/usr/bin/env bash
# fishbowl-server: stop, start or restart Fishbowl Server from a terminal or a
# script, the same as the buttons on the Fishbowl page. MySQL and the page keep
# running either way.
#
#   docker exec fishbowl fishbowl-server status
#   docker exec fishbowl fishbowl-server stop    [--wait]
#   docker exec fishbowl fishbowl-server start   [--wait]
#   docker exec fishbowl fishbowl-server restart [--wait]
#
# --wait waits (up to FISHBOWL_SERVER_WAIT seconds, default 900) until Fishbowl
# Server is stopped, or running again, and exits 1 if it doesn't get there.
# status prints the container's status word (running, paused, starting, ...).
#
# Exit status: 0 = done (or asked for), 1 = not possible right now or timed out,
# 2 = usage.

# shellcheck source=/dev/null
. /usr/local/lib/fishbowl/common.sh

action="${1:-}"
wait_for=0
[ "${2:-}" = --wait ] && wait_for=1
case "$action" in
  status) current_status; exit 0 ;;
  stop|start|restart) ;;
  *) note "Usage: fishbowl-server status | stop|start|restart [--wait]"; exit 2 ;;
esac
[ "$(id -u)" = 0 ] || fail 1 "Run it as root: docker exec <container> fishbowl-server $action"
setup_complete || fail 1 "Fishbowl isn't installed yet. Finish first-time setup first (the Fishbowl page, or fishbowl-setup)."

before="$(current_status)"
case "$action:$before" in
  stop:running|restart:running|start:paused|start:server-failed|restart:paused|restart:server-failed) ;;
  stop:paused|stop:server-failed) note "Fishbowl Server is already stopped (status: $before)."; exit 0 ;;
  start:running) note "Fishbowl Server is already running."; exit 0 ;;
  *) fail 1 "Fishbowl Server can't be asked to $action right now (status: $before)." ;;
esac
[ "$action" = restart ] && [ "$before" != running ] && action=start
web_request "server-$action"
note "Asked Fishbowl Server to $action (status was: $before)."
[ "$wait_for" = 1 ] || exit 0

limit="${FISHBOWL_SERVER_WAIT:-900}"
[[ "$limit" =~ ^[0-9]+$ ]] || limit=900
want=running
[ "$action" = stop ] && want=paused
seen_other=0
for _ in $(seq 1 "$limit"); do
  now="$(current_status)"
  [ "$now" != "$before" ] && seen_other=1
  if [ "$now" = "$want" ] && { [ "$seen_other" = 1 ] || [ "$action" = stop ]; }; then
    note "Fishbowl Server is $( [ "$want" = running ] && echo running || echo stopped )."
    exit 0
  fi
  case "$now" in
    server-failed) [ "$seen_other" = 1 ] && fail 1 "Fishbowl Server didn't start: $(cat "$MESSAGE_FILE" 2>/dev/null || echo 'see the container log')" ;;
  esac
  sleep 1
done
fail 1 "Fishbowl Server wasn't $want after ${limit}s (status: $(current_status))."
