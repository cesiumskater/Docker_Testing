# Per-site settings for compose.yaml. Copy this file to .env in the same folder
# and change what you need; Compose reads .env by itself. Never put a password
# here. Lines starting with # are notes.

# Your time zone, as a tz database name (works on Windows too).
FB_TZ=America/Denver

# The address of this computer that Fishbowl Clients, integrated apps and
# browsers use. 0.0.0.0 means every IPv4 address it has. Naming one address (CIS
# Docker Benchmark 5.14) keeps the ports off any other network this computer is on.
FB_LAN_IP=0.0.0.0

# The name (or IP address) people type to reach this computer, for example
# fishbowl.example.com or 192.168.1.20. The edge's certificate is made for it.
FB_PUBLIC_HOST=localhost

# Ports on this computer. The page's two stay the same inside the containers.
FB_HTTPS_PORT=443      # the Fishbowl page over HTTPS, for your network
FB_PAGE_PORT=6080      # the Fishbowl page, on this computer only (127.0.0.1)
# Fishbowl Server's two ports, the same on this computer and inside: Server
# Administration's Port and Legacy Port are set to them at every start. Only this
# pair is published, so a second Fishbowl on this computer can use another one,
# for example 2457 and 28193 (README, "Two Fishbowl Servers on one computer").
FB_CLIENT_PORT=2456    # Fishbowl Clients and the REST API
FB_API_PORT=28192      # Fishbowl's legacy API, for integrated apps

# Where the edge's certificate comes from (README, "The HTTPS front door"):
#   internal                        the edge's own certificate authority (default);
#                                   browsers and Clients trust its root once
#   /certs/tls.crt /certs/tls.key   your own certificate and key, in FB_TLS_DIR
#   you@example.com                 a public certificate from Let's Encrypt (needs
#                                   FB_PUBLIC_HOST in public DNS, 80 and 443 open to it)
FB_TLS=internal
FB_TLS_DIR=./certs

# TLS for Fishbowl Clients on 2456:
#   off   Clients connect as they always have (default)
#   edge  the edge terminates TLS with its certificate; Clients connect to
#         FB_PUBLIC_HOST with Secure Connection on
FB_CLIENT_TLS=off

# The egress proxy lets Fishbowl reach only Fishbowl's own servers. More names,
# separated by spaces or commas, for an integration's servers or a plugin's, for
# example: quickbooks.api.intuit.com appcenter.intuit.com
FB_EGRESS_EXTRA=
# If your network reaches the internet only through its own proxy: host:port.
FB_EGRESS_UPSTREAM=

# Fishbowl Server's heap, for example 6g or 4096m. Empty: Server
# Administration's memory setting stands (8 GB from setup). Keep FB_MEM_LIMIT
# well above it: Java also uses memory outside the heap.
FB_SERVER_XMX=

# Optional memory caps, for example 12g. 0: no cap. Fishbowl Server alone may
# use 8 GB, each window up to 2 GB.
FB_MEM_LIMIT=0           # the fishbowl container (Fishbowl Server)
FB_DESKTOP_MEM_LIMIT=0   # the desktop container (Server Administration, the Client)
FB_DB_MEM_LIMIT=0        # the db container (MySQL)

# The nightly backup (the backup container): when, in FB_TZ, and how many sets
# to keep. Sets land in the fishbowl-backups volume; copy it offsite (README).
FB_BACKUP_TIME=01:17
FB_BACKUP_KEEP_DAILY=14
FB_BACKUP_KEEP_WEEKLY=8
FB_BACKUP_KEEP_MONTHLY=12

# Fishbowl's own updates (README, "Fishbowl's own updates"). 0 (default): updates
# come only as new images, upgraded on the Fishbowl page. 1: Fishbowl may also
# download and apply its own updates, and it then leaves database backups to the
# backup container.
FB_NATIVE_UPDATES=0

# The MySQL root password file (decision 3), mounted as a Compose secret into
# fishbowl, db and backup only. One line, no other text.
FB_MYSQL_ROOT_PASSWORD_FILE=./secrets/mysql-root-password.txt

# MySQL's network. Change both only if 172.31.240.0/24 is already in use on your
# network; root may sign in only from this range (decision 3), never from anywhere.
FB_DATA_SUBNET=172.31.240.0/24
FB_DATA_ROOT_HOST=172.31.240.%

# Build from a clone of the repository instead of GitHub (for example .).
# FB_SOURCE=.
