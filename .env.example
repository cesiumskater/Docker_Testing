# Per-site settings for compose.yaml. Copy this file to .env in the same folder
# and change what you need; Compose reads .env by itself. Never put a password
# here. Lines starting with # are notes. After a change: docker compose up -d

# Your time zone, as a tz database name (works on Windows too).
FB_TZ=America/Denver

# The address of this computer that Fishbowl Clients and integrated apps use.
# 0.0.0.0 means every IPv4 address it has. Naming one address (CIS Docker
# Benchmark 5.14) keeps the ports off any other network this computer is on.
FB_LAN_IP=0.0.0.0

# Ports on this computer. The ones inside the container never change.
FB_CLIENT_PORT=2456
FB_API_PORT=28192
FB_PAGE_PORT=6080

# Fishbowl Server's Java heap (-Xmx), such as 6144m or 6g. Empty: the value set in
# Server Administration (8192 MB after setup) applies. Set, it wins over Server
# Administration at every start.
FB_SERVER_XMX=

# Optional memory cap for the container, for example 14g. 0 means no cap. Leave
# room above the heap: Java and MySQL use memory beyond it (README section 2).
FB_MEM_LIMIT=0

# The daily backup of every database (and Fishbowl's settings files), at this
# time in FB_TZ; "off" turns it off. How many to keep (the newest).
FB_BACKUP_TIME=01:17
FB_BACKUP_KEEP=7

# 1: Fishbowl Server's and MySQL's own logs also go to `docker logs`.
FB_LOG_STREAM=1

# 1: the watchdog restarts Fishbowl Server or MySQL when it stops answering.
FB_WATCHDOG=1
