# Per-site settings for compose.yaml. Copy this file to .env in the same folder
# and change what you need; Compose reads .env by itself. Never put a password
# here. Lines starting with # are notes.

# Your time zone, as a tz database name (works on Windows too).
FB_TZ=America/Denver

# The address of this computer that Fishbowl Clients and integrated apps use.
# 0.0.0.0 means every IPv4 address it has. Naming one address (CIS Docker
# Benchmark 5.14) keeps the ports off any other network this computer is on.
FB_LAN_IP=0.0.0.0

# Ports on this computer. The ones inside the container never change.
FB_CLIENT_PORT=2456
FB_API_PORT=28192
FB_PAGE_PORT=6080

# Optional memory cap for the container, for example 14g. 0 means no cap.
FB_MEM_LIMIT=0
