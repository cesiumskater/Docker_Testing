#!/bin/bash
#
# fishbowl-backup: the backup container's job (README, "Backups in the Compose
# stack"). Every day at FB_BACKUP_TIME (your TZ) it dumps every MySQL database
# from the database container into a new backup set, checks it, and keeps
# FB_BACKUP_KEEP_DAILY daily, FB_BACKUP_KEEP_WEEKLY weekly and
# FB_BACKUP_KEEP_MONTHLY monthly sets.
#
#   fishbowl-backup run          the daily loop (the container's main process)
#   fishbowl-backup --now        one backup set now
#   fishbowl-backup --verify [SET]
#                                check a set (default: the newest): every file
#                                decompresses, every dump ends with MySQL's
#                                "Dump completed" line, and MANIFEST.sha256 matches
#   fishbowl-backup --latest [DATABASE]
#                                the newest set's dump of DATABASE (default: the
#                                dump of all databases)
#   fishbowl-backup --list       every set, newest first, with its size
#   fishbowl-backup --health     for the health check: 0 when the newest set is
#                                under 26 hours old (or none was due yet)
#
# A set is a folder under /backups named after its UTC time:
#   all-databases.sql.gz   every database, for a full restore
#   <database>.sql.gz      each company database alone, rows in primary-key order
#                          and no dump date, so the same data gives the same file
#   eve.properties, dbsettings.properties
#                          Fishbowl's server settings (the License Key is in them)
#   reports.tar.gz         Fishbowl's report files (server/reports): the database
#                          holds only each report's name and path, so a custom
#                          report lives here, not in the dumps (E13)
#   MANIFEST.sha256        a SHA-256 for each file above
# Files are readable by this container's user only. There's no route out of the
# data network, on purpose: copy /backups (the fishbowl-backups volume) offsite
# from the computer that runs Docker (README).
#
# Exit status: 0 = done; 1 = failed (the reason is printed); 2 = bad usage.
set -uo pipefail
umask 077

BACKUPS=/backups
APP=/fishbowl-app/server/bin
DB_HOST="${FB_DB_HOST:-db}"
PW_FILE="${MYSQL_ROOT_PASSWORD_FILE:-/run/secrets/mysql_root}"
AT="${FB_BACKUP_TIME:-01:17}"
KEEP_DAILY="${FB_BACKUP_KEEP_DAILY:-14}"
KEEP_WEEKLY="${FB_BACKUP_KEEP_WEEKLY:-8}"
KEEP_MONTHLY="${FB_BACKUP_KEEP_MONTHLY:-12}"
STATE=/backups/.last-success
STARTED=/tmp/.fishbowl-backup-started

log()  { printf '%s [backup] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }
warn() { printf '%s [warning] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }
die()  { warn "$*"; exit 1; }

[[ "$AT" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || { warn "FB_BACKUP_TIME must be HH:MM (24-hour); it's '$AT'."; exit 2; }
for n in "$KEEP_DAILY" "$KEEP_WEEKLY" "$KEEP_MONTHLY"; do
  [[ "$n" =~ ^[0-9]{1,3}$ ]] || { warn "FB_BACKUP_KEEP_DAILY, _WEEKLY and _MONTHLY take a number from 0 to 999."; exit 2; }
done
[ "$KEEP_DAILY" -ge 1 ] || { warn "FB_BACKUP_KEEP_DAILY must be at least 1."; exit 2; }

password() {
  local pw=""
  [ -r "$PW_FILE" ] || die "The MySQL root password file $PW_FILE can't be read (the mysql_root secret in compose.yaml)."
  IFS= read -r pw < "$PW_FILE" || true
  [ -n "$pw" ] || die "The MySQL root password file $PW_FILE is empty."
  printf '%s' "$pw"
}
# my_root CMD ARGS: a MySQL client as root on the database container; the password
# goes through MYSQL_PWD for that one process.
my_root() { local c="$1"; shift; MYSQL_PWD="$(password)" "$c" --protocol=tcp -h "$DB_HOST" -P 3306 -u root "$@"; }

newest_set() { find "$BACKUPS" -mindepth 1 -maxdepth 1 -type d -name '20*Z' -printf '%f\n' 2>/dev/null | sort -r | head -n 1; }

# dump_ok FILE: decompresses, and ends with MySQL's own completion line.
dump_ok() { gzip -t "$1" 2>/dev/null && gzip -dc "$1" | tail -n 1 | grep -q '^-- Dump completed'; }

backup_now() {
  local stamp dir part dbs db size avail need start
  start=$(date +%s)
  my_root mysqladmin --connect-timeout=10 ping --silent >/dev/null 2>&1 ||
    die "The database container ($DB_HOST:3306) isn't answering, or turns root's password down; no backup taken."
  dbs="$(my_root mysql -N -B -e "SELECT schema_name FROM information_schema.schemata WHERE schema_name NOT IN ('mysql','information_schema','performance_schema','sys') ORDER BY schema_name")" ||
    die "Couldn't list the databases; no backup taken."
  # Room for it: the data's size on disk is a generous upper bound for the
  # compressed dumps (twice: the all-databases file and the per-database ones).
  size="$(my_root mysql -N -B -e "SELECT COALESCE(SUM(data_length + index_length), 0) FROM information_schema.tables")" || size=0
  avail=$(( $(df -Pk "$BACKUPS" | awk 'NR == 2 {print $4}') * 1024 ))
  need=$(( size * 2 / 3 + 50 * 1024 * 1024 ))
  [ "$avail" -gt "$need" ] || die "Only $((avail / 1048576)) MB free on the backups volume; about $((need / 1048576)) MB needed. No backup taken."

  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  dir="$BACKUPS/$stamp"
  part="$BACKUPS/.$stamp.part"
  rm -rf "$part"; mkdir -p "$part"
  log "Backup set $stamp: every database from $DB_HOST"
  # One consistent snapshot of every database (InnoDB), with routines, events and triggers.
  if ! my_root mysqldump --all-databases --single-transaction --routines --events --triggers \
        --hex-blob --set-gtid-purged=OFF --max-allowed-packet=1G 2>"$part/.err" | gzip -6 > "$part/all-databases.sql.gz"; then
    sed 's/^/    /' "$part/.err" >&2; rm -rf "$part"; die "mysqldump of all databases failed; no backup set kept."
  fi
  dump_ok "$part/all-databases.sql.gz" || { rm -rf "$part"; die "The dump of all databases is incomplete; no backup set kept."; }
  for db in $dbs; do
    if ! my_root mysqldump --databases "$db" --single-transaction --routines --events --triggers --hex-blob \
          --set-gtid-purged=OFF --order-by-primary --skip-dump-date --max-allowed-packet=1G 2>"$part/.err" |
          gzip -n -6 > "$part/$db.sql.gz"; then
      sed 's/^/    /' "$part/.err" >&2; rm -rf "$part"; die "mysqldump of $db failed; no backup set kept."
    fi
    dump_ok "$part/$db.sql.gz" || { rm -rf "$part"; die "The dump of $db is incomplete; no backup set kept."; }
  done
  rm -f "$part/.err"
  local f
  for f in eve.properties dbsettings.properties; do
    if [ -r "$APP/$f" ]; then cp "$APP/$f" "$part/$f"; else warn "Fishbowl's $f isn't readable here ($APP); the set has the databases only."; fi
  done
  if [ -d "$APP/../reports" ]; then
    tar -C "$APP/.." -czf "$part/reports.tar.gz" reports 2>"$part/.err" ||
      { sed 's/^/    /' "$part/.err" >&2; rm -rf "$part"; die "Couldn't archive Fishbowl's report files; no backup set kept."; }
    rm -f "$part/.err"
  else
    warn "Fishbowl's report folder isn't here ($APP/../reports); the set has no reports.tar.gz."
  fi
  ( cd "$part" && sha256sum -- * > MANIFEST.sha256 )
  chmod 0600 "$part"/*
  mv "$part" "$dir"
  date -u +%Y-%m-%dT%H:%M:%SZ > "$STATE"
  log "Backup set $stamp done in $(( $(date +%s) - start ))s: $(du -sh "$dir" | cut -f1), databases: $(printf '%s ' $dbs)"
  while IFS= read -r line; do log "  $line"; done < "$dir/MANIFEST.sha256"
  prune
  printf '%s\n' "$dir"
}

# prune: keep the newest KEEP_DAILY sets, the newest of each of the last
# KEEP_WEEKLY weeks and of each of the last KEEP_MONTHLY months; the newest set is
# always kept.
prune() {
  local sets=() keep=() s d wk mo i
  mapfile -t sets < <(find "$BACKUPS" -mindepth 1 -maxdepth 1 -type d -name '20*Z' -printf '%f\n' | sort -r)
  declare -A seen_w=() seen_m=() keepset=()
  for i in "${!sets[@]}"; do
    s="${sets[$i]}"
    d="${s:0:4}-${s:4:2}-${s:6:2}"
    wk="$(date -u -d "$d" +%G-%V)"; mo="${s:0:6}"
    if [ "$i" -lt "$KEEP_DAILY" ]; then keepset[$s]=1; fi
    if [ -z "${seen_w[$wk]:-}" ] && [ "${#seen_w[@]}" -lt "$KEEP_WEEKLY" ]; then seen_w[$wk]=1; keepset[$s]=1; fi
    if [ -z "${seen_m[$mo]:-}" ] && [ "${#seen_m[@]}" -lt "$KEEP_MONTHLY" ]; then seen_m[$mo]=1; keepset[$s]=1; fi
  done
  for s in "${sets[@]}"; do
    if [ -z "${keepset[$s]:-}" ]; then rm -rf -- "${BACKUPS:?}/$s" && log "Removed backup set $s (retention ${KEEP_DAILY}/${KEEP_WEEKLY}/${KEEP_MONTHLY})"; fi
  done
  find "$BACKUPS" -mindepth 1 -maxdepth 1 -name '.*.part' -mmin +1440 -exec rm -rf {} + 2>/dev/null || true
}

verify() {
  local s="${1:-$(newest_set)}" dir f bad=0 age
  [ -n "$s" ] || die "There's no backup set yet."
  dir="$BACKUPS/${s##*/}"
  [ -d "$dir" ] || die "No such backup set: $s"
  ( cd "$dir" && sha256sum -c --quiet MANIFEST.sha256 ) || { warn "$s: MANIFEST.sha256 doesn't match."; bad=1; }
  for f in "$dir"/*.sql.gz; do
    dump_ok "$f" || { warn "$s: ${f##*/} is damaged or incomplete."; bad=1; }
  done
  if [ -f "$dir/reports.tar.gz" ]; then
    tar -tzf "$dir/reports.tar.gz" >/dev/null 2>&1 || { warn "$s: reports.tar.gz is damaged."; bad=1; }
  fi
  age=$(( ( $(date -u +%s) - $(date -u -d "${s:0:4}-${s:4:2}-${s:6:2}T${s:9:2}:${s:11:2}:${s:13:2}Z" +%s) ) / 3600 ))
  [ "$bad" = 0 ] || die "Backup set $s failed its check."
  log "Backup set $s checks out ($(ls "$dir"/*.sql.gz | wc -l) dumps, manifest matches; ${age} h old)"
  if [ -z "${1:-}" ] && [ "$age" -ge 26 ]; then die "The newest backup set is ${age} hours old (over 26)."; fi
}

latest() {
  local s f
  s="$(newest_set)"; [ -n "$s" ] || die "There's no backup set yet."
  f="$BACKUPS/$s/${1:-all-databases}.sql.gz"
  [ -f "$f" ] || die "Backup set $s has no dump of ${1:-all databases}."
  printf '%s\n' "$f"
}

health() {
  local last now
  now=$(date -u +%s)
  if [ -f "$STATE" ]; then
    last=$(date -u -d "$(cat "$STATE")" +%s 2>/dev/null || echo 0)
    [ $(( now - last )) -lt $(( 26 * 3600 )) ] && { echo "newest backup set: $(cat "$STATE")"; exit 0; }
    echo "the newest backup set is from $(cat "$STATE"), over 26 hours ago"; exit 1
  fi
  # No set yet: fine until the first one was due (26 hours after the start).
  if [ -f "$STARTED" ] && [ $(( now - $(cat "$STARTED") )) -lt $(( 26 * 3600 )) ]; then echo "no backup set yet; the first is due at $AT"; exit 0; fi
  echo "no backup set has been written"; exit 1
}

# seconds until the next HH:MM in the container's time zone (TZ)
until_next() {
  local now next
  now=$(date +%s)
  next=$(date -d "today $AT" +%s)
  [ "$next" -gt "$now" ] || next=$(date -d "tomorrow $AT" +%s)
  echo $(( next - now ))
}

run_loop() {
  date -u +%s > "$STARTED"
  trap 'log "Stopping"; exit 0' TERM INT
  log "Daily backup at $AT ($(date +%Z)); keeping $KEEP_DAILY daily, $KEEP_WEEKLY weekly and $KEEP_MONTHLY monthly sets in $BACKUPS"
  while :; do
    local wait_s
    wait_s="$(until_next)"
    log "Next backup in $((wait_s / 3600))h $(( (wait_s % 3600) / 60 ))m"
    sleep "$wait_s" & wait $!
    ( backup_now >/dev/null ) || warn "Today's backup failed (reason above); trying again tomorrow at $AT, or now: docker exec fishbowl-backup fishbowl-backup --now"
    ( verify >/dev/null ) || true
  done
}

case "${1:-run}" in
  run)       run_loop ;;
  --now)     backup_now ;;
  --verify)  verify "${2:-}" ;;
  --latest)  latest "${2:-}" ;;
  --list)    find "$BACKUPS" -mindepth 1 -maxdepth 1 -type d -name '20*Z' -printf '%f\n' | sort -r |
               while IFS= read -r s; do printf '%s  %s\n' "$s" "$(du -sh "$BACKUPS/$s" | cut -f1)"; done ;;
  --health)  health ;;
  -h|--help) sed -n '3,36p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)         warn "Usage: fishbowl-backup run | --now | --verify [SET] | --latest [DATABASE] | --list | --health"; exit 2 ;;
esac
